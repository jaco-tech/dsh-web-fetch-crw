{
  "name": "@jaco-tech/dsh-web-fetch-crw",
  "description": "crw (Firecrawl-compatible) fetch provider for the DeepSeek Harness web capability seam (ctx.web). No auth, no API key.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaco-tech/dsh-web-fetch-crw.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "firecrawl",
    "web-fetch",
    "crawler",
    "cordis-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc"
  }
}